# Primary connection (recommended). Must end with /sturum for Atlas, or set MONGO_DB_NAME.
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/sturum?retryWrites=true&w=majority

# Legacy names (optional fallbacks if MONGO_URI is unset)
MONGO_URI_COMPASS=mongodb://localhost:27017/sturum
MONGO_URI_ATLAS=mongodb+srv://user:pass@cluster.mongodb.net/sturum?retryWrites=true&w=majority
MONGO_DB_NAME=sturum
PORT=4000
SECRET=your_jwt_secret_here
REFRESH_SECRET=your_refresh_secret_here
# Live Vercel URL (no trailing slash). Required on Render for email links + CORS.
# Example: https://sturum-main-new.vercel.app
FRONTEND_URL=http://localhost:3000

# Optional extra origins (comma-separated). Vercel *.vercel.app is allowed in production by default.
# ALLOWED_ORIGINS=https://sturum-main-new.vercel.app,https://another-preview.vercel.app
# ALLOW_VERCEL_ORIGINS=true

# Public backend URL (Render only). Verification emails use API redirect → frontend.
# Local dev: leave unset OR use localhost — links go to FRONTEND_URL (React on :3000).
# API_PUBLIC_URL=https://your-backend.onrender.com

NODE_ENV=development
APP_NAME=Sturum

# --- Gmail (signup / verification emails) ---
# 1. Google Account → Security → turn on 2-Step Verification
# 2. Security → App passwords → create one for "Mail" / "Other (Sturum)"
# 3. Use that 16-character password as SMTP_PASS (not your normal Gmail password)
# 4. SMTP_USER must be the full Gmail address that owns the app password
#
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.name@gmail.com
# Paste app password without spaces (or spaces are stripped automatically)
SMTP_PASS=xxxxxxxxxxxxxxxx
SMTP_FROM=Sturum <your.name@gmail.com>

# On Render: add the same SMTP_* vars in the dashboard (not only in local .env).
# After deploy, check Render logs for "[email] SMTP connection OK" or an error.
